<script>
const ids2 = ['s-prix','s-apport','s-taux','s-duree','s-travaux','s-ca','s-charges'];
let simChart2 = null;

function fmt2(n) { return Math.round(n).toLocaleString('fr-FR') + ' €'; }

function pmt2(rate, nper, pv) {
  if (rate === 0) return pv / nper;
  return pv * rate * Math.pow(1 + rate, nper) / (Math.pow(1 + rate, nper) - 1);
}

function runSim() {
  const prix = +document.getElementById('s-prix').value;
  const apportPct = +document.getElementById('s-apport').value / 100;
  const taux = +document.getElementById('s-taux').value / 100;
  const duree = +document.getElementById('s-duree').value;
  const travaux = +document.getElementById('s-travaux').value;
  const ca = +document.getElementById('s-ca').value;
  const chargesPct = +document.getElementById('s-charges').value / 100;

  document.getElementById('o-prix').textContent = fmt2(prix);
  document.getElementById('o-apport').textContent = Math.round(+document.getElementById('s-apport').value) + ' %';
  document.getElementById('o-taux').textContent = (+document.getElementById('s-taux').value).toFixed(1).replace('.',',') + ' %';
  document.getElementById('o-duree').textContent = duree + ' ans';
  document.getElementById('o-travaux').textContent = fmt2(travaux);
  document.getElementById('o-ca').textContent = fmt2(ca);
  document.getElementById('o-charges').textContent = Math.round(+document.getElementById('s-charges').value) + ' %';

  const investTotal = prix + travaux;
  const apportEuros = Math.round(investTotal * apportPct);
  const emprunt = investTotal - apportEuros;
  const annuite = Math.round(pmt2(taux / 12, duree * 12, emprunt) * 12);
  const ebe = Math.round(ca * (1 - chargesPct));
  const cashNet = ebe - annuite;
  const margeNette = ebe / ca * 100;

  const cashflows = [];
  let cumul = -apportEuros;
  for (let y = 1; y <= 8; y++) {
    const annuiteY = y <= duree ? annuite : 0;
    const net = ebe - annuiteY;
    cumul += net;
    cashflows.push({ y, ebe, annuiteY, net, cumul });
  }

  const roi = cashflows.findIndex(c => c.cumul >= 0);
  const roiLabel = roi === -1 ? '> 8 ans' : cashflows[roi].y + ' ans';
  const roiClass = roi !== -1 && cashflows[roi].y <= 5 ? 'green' : roi !== -1 && cashflows[roi].y <= 7 ? 'gold' : 'red';

  document.getElementById('kpis2').innerHTML = `
    <div class="kpi2"><div class="kpi2-val">${fmt2(investTotal)}</div><div class="kpi2-label">Invest. total</div></div>
    <div class="kpi2"><div class="kpi2-val">${fmt2(ebe)}</div><div class="kpi2-label">EBE annuel</div></div>
    <div class="kpi2"><div class="kpi2-val ${cashNet >= 0 ? 'green' : 'red'}">${fmt2(cashNet)}</div><div class="kpi2-label">Cash net / an</div></div>
    <div class="kpi2"><div class="kpi2-val ${roiClass}">${roiLabel}</div><div class="kpi2-label">ROI</div></div>
  `;

  document.getElementById('simTbody').innerHTML = cashflows.map(c => `
    <tr>
      <td><strong>An ${c.y}</strong></td>
      <td>${fmt2(c.ebe)}</td>
      <td class="${c.annuiteY > 0 ? 'neg' : ''}">${c.annuiteY > 0 ? '− ' + fmt2(c.annuiteY) : '—'}</td>
      <td class="${c.net >= 0 ? 'pos' : 'neg'}">${fmt2(c.net)}</td>
      <td class="${c.cumul >= 0 ? 'pos' : 'neg'}">${fmt2(c.cumul)}</td>
    </tr>
  `).join('');

  const labels = cashflows.map(c => 'An ' + c.y);
  const data = cashflows.map(c => Math.round(c.cumul));
  const colors = data.map(v => v >= 0 ? '#1D9E75' : '#c84b1a');

  if (simChart2) simChart2.destroy();
  simChart2 = new Chart(document.getElementById('simChart'), {
    type: 'bar',
    data: {
      labels,
      datasets: [{ data, backgroundColor: colors, borderRadius: 4, borderSkipped: false }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => ' ' + Math.round(ctx.raw).toLocaleString('fr-FR') + ' €' } } },
      scales: {
        x: { grid: { display: false }, ticks: { font: { size: 11 } } },
        y: { grid: { color: 'rgba(0,0,0,0.05)' }, ticks: { font: { size: 11 }, callback: v => (v < 0 ? '−' : '') + Math.abs(Math.round(v / 1000)) + 'k€' } }
      }
    }
  });

  let vClass, vIcon, vTitle, vSub;
  if (cashNet < 0) {
    vClass = 'bad'; vIcon = '🔴';
    vTitle = 'Cash-flow négatif — revoir les paramètres';
    vSub = 'Les annuités dépassent l\'EBE. Envisagez d\'allonger la durée du prêt, d\'augmenter l\'apport ou de revoir le CA prévisionnel.';
  } else if (roi !== -1 && cashflows[roi].y <= 5) {
    vClass = 'good'; vIcon = '🟢';
    vTitle = 'Excellent profil — opération très rentable';
    vSub = `Retour sur investissement en ${cashflows[roi].y} ans. Cash net de ${fmt2(cashNet)}/an pendant le remboursement, puis free cash-flow total.`;
  } else if (roi !== -1 && cashflows[roi].y <= 7) {
    vClass = 'warn'; vIcon = '🟡';
    vTitle = 'Profil correct — peu de marge de sécurité';
    vSub = `ROI en ${cashflows[roi].y} ans. Acceptable, mais surveillez l'évolution des charges et du CA. Prévoyez une réserve de 2 mois.`;
  } else {
    vClass = 'bad'; vIcon = '🔴';
    vTitle = 'Retour trop long — négociez ou ajustez';
    vSub = 'Plus de 8 ans avant de récupérer l\'apport. Renégociez le prix d\'achat ou améliorez les hypothèses d\'exploitation.';
  }
  const v = document.getElementById('simVerdict');
  v.className = 'verdict-box ' + vClass;
  v.innerHTML = `<div class="verdict-icon">${vIcon}</div><div><div class="verdict-title">${vTitle}</div><div class="verdict-sub">${vSub}</div></div>`;
}

ids2.forEach(id => document.getElementById(id).addEventListener('input', runSim));
runSim();
</script>
